# OPTIONAL. You do not need this file.
#
# The normal auth path is per-agent OAuth, done once inside the container - no
# keys anywhere. This file exists only for three cases:
#
#   - Kimi, while new subscriptions are sold out (Moonshot pay-as-you-go key)
#   - Gemini, if you would rather skip the host-seeding step (free AI Studio key)
#   - Claude, if you bill per-token against the API instead of a Pro/Max plan
#
# It is also only read by agent.sh, the optional CLI launcher. VS Code resolves
# ${localEnv:...} against its own environment, not this file.
#
#     cp .devcontainer/.env.example .env.agents
#
# i.e. <workspace-root>/.devcontainer/  ->  <workspace-root>/.env.agents
#
# That location is deliberate: outside the Docker build context, and outside
# every mount (agents see only the children of the workspace root that you list
# in "mounts", never the root itself). Add .env.agents to .gitignore.

# Container timezone.
TZ=America/Los_Angeles

# Optional. Override the workspace root if it is NOT the folder directly above
# the devcontainer/ folder. ${localWorkspaceFolder} in devcontainer.json resolves
# to this, and every mount path is written relative to it.
# AGENT_WORKSPACE_ROOT=/absolute/path/to/workspace/root

# Optional. Anthropic API key, for billing Claude Code per token instead of
# against a Claude Pro/Max subscription. https://console.anthropic.com/settings/keys
# Leave empty to use the subscription OAuth login (`/login` inside Claude Code).
ANTHROPIC_API_KEY=

# Optional. Free Google AI Studio key - no credit card, no expiry.
# https://aistudio.google.com/apikey
# Useful as a first smoke test because it sidesteps Gemini's broken in-container
# OAuth. Leave empty to use OAuth credentials seeded from the host instead.
GEMINI_API_KEY=

# Optional. Moonshot pay-as-you-go key, used as a fallback while Kimi Code
# subscriptions are sold out. https://platform.kimi.com
MOONSHOT_API_KEY=
